---
import BrandLogo from './BrandLogo.astro';

const links = [
  { href: '/servizi/', label: 'Lavorazioni' },
  { href: '/lavori/', label: 'I nostri lavori' },
  { href: '/chi-siamo/', label: 'Chi siamo' },
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Todaro Company, home">
    <BrandLogo variant="light" />
  </a>
  <nav class="desktop-nav" aria-label="Navigazione principale">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <a class="button button-dark header-cta" href="/contatti/">Parliamo del tuo progetto <span aria-hidden="true">↗</span></a>
  <button class="theme-toggle" type="button" aria-label="Modalità scura" aria-pressed="false" title="Attiva modalità scura">
    <svg class="theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z" /></svg>
    <svg class="theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
  </button>
  <details class="mobile-menu">
    <summary aria-label="Apri il menu"><span></span><span></span></summary>
    <nav aria-label="Navigazione mobile">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="/contatti/">Richiedi un preventivo</a>
    </nav>
  </details>
</header>
