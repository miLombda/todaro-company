---
import SiteLayout from '../layouts/SiteLayout.astro';

const address = 'Via Madonnelle 27, 80038 Pomigliano d’Arco NA';
const mapUrl = 'https://maps.google.com/?q=Via+Madonnelle+27,+80038+Pomigliano+d%27Arco+NA';
---

<SiteLayout title="Contatti e preventivi" description="Contatta Todaro Company per un preventivo: telefonaci, scrivici su WhatsApp o vieni a trovarci a Pomigliano d'Arco.">
  <section class="page-hero contact-page-hero section-wrap">
    <p class="eyebrow">Raccontaci la tua idea</p>
    <h1>Ci stampiamo<br /><span>un caffè?</span></h1>
    <p class="page-lead">Parlaci del tuo progetto: ti aiutiamo a trovare la tecnica e il supporto più adatti.</p>
  </section>
  <section class="contact-grid section-wrap">
    <div class="contact-card contact-card-dark">
      <p class="eyebrow">Preventivi e informazioni</p>
      <h2>Un contatto<br />alla volta.</h2>
      <a href="tel:+390818846481"><span>Telefono</span><strong>+39 081 884 64 81</strong><b aria-hidden="true">↗</b></a>
      <a href="https://wa.me/393454700420" target="_blank" rel="noreferrer"><span>WhatsApp</span><strong>+39 345 470 04 20</strong><b aria-hidden="true">↗</b></a>
      <a href="mailto:todarocompany@libero.it"><span>Email</span><strong>todarocompany@libero.it</strong><b aria-hidden="true">↗</b></a>
    </div>
    <div class="contact-card contact-card-map">
      <p class="eyebrow">Vieni a trovarci</p>
      <h2>Ci trovi<br />qui.</h2>
      <p class="address">{address}</p>
      <a class="button button-dark" href={mapUrl} target="_blank" rel="noreferrer">Apri Google Maps <span aria-hidden="true">↗</span></a>
      <div class="map-art" aria-hidden="true"><span>NA</span><i>✳</i><b>40.91° N<br />14.39° E</b></div>
    </div>
  </section>
  <section class="quote-section section-wrap">
    <div class="quote-heading">
      <p class="eyebrow">Richiesta preventivo</p>
      <h2>Raccontaci<br />il tuo progetto.</h2>
      <p>Indicaci i dettagli che hai già. Ti ricontatteremo per parlarne insieme.</p>
    </div>
    <form
      class="quote-form"
      name="richiesta-preventivo"
      method="POST"
      action="/.netlify/functions/richiesta-preventivo"
      enctype="application/x-www-form-urlencoded"
    >
      <div class="form-honeypot" aria-hidden="true">
        <label>Non compilare questo campo: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="form-fields">
        <label class="form-field">
          <span>Nome e cognome <b aria-hidden="true">*</b></span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label class="form-field">
          <span>Email <b aria-hidden="true">*</b></span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label class="form-field">
          <span>Telefono (facoltativo)</span>
          <input type="tel" name="phone" autocomplete="tel" />
        </label>
        <label class="form-field">
          <span>Tipo di capo o supporto</span>
          <input type="text" name="support" placeholder="Es. t-shirt, felpe, borse..." />
        </label>
        <label class="form-field">
          <span>Quantità indicativa</span>
          <input type="text" name="quantity" placeholder="Es. 50 pezzi" />
        </label>
        <label class="form-field">
          <span>Lavorazione</span>
          <select name="technique">
            <option value="">Seleziona una lavorazione</option>
            <option value="Serigrafia">Serigrafia</option>
            <option value="DTF">DTF</option>
            <option value="Stampa digitale / plotter">Stampa digitale / plotter</option>
            <option value="Applicazioni e Brik">Applicazioni e Brik</option>
            <option value="Da valutare insieme">Da valutare insieme</option>
          </select>
        </label>
        <label class="form-field form-field-wide">
          <span>Descrivi il progetto <b aria-hidden="true">*</b></span>
          <textarea name="message" rows="5" required></textarea>
        </label>
      </div>

      <p class="form-privacy-note">Consulta l’<a href="/privacy/">informativa privacy</a> per sapere come verranno trattati i dati inviati con questa richiesta.</p>

      <p class="form-required-note">* Campi obbligatori</p>
      <button class="button button-dark form-submit" type="submit">Invia richiesta <span aria-hidden="true">↗</span></button>
    </form>
  </section>
  <p class="contact-hours section-wrap">Per richieste urgenti puoi chiamarci al <a href="tel:+390818846481">+39 081 884 64 81</a>.</p>
</SiteLayout>
