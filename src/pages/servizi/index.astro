---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { services } from '../../data/services';
---

<SiteLayout title="Lavorazioni" description="Scopri le tecniche di stampa e personalizzazione di Todaro Company: serigrafia, effetti speciali e applicazioni da plotter.">
  <section class="page-hero section-wrap">
    <p class="eyebrow">Tecnica e immaginazione</p>
    <h1>Le nostre<br /><span>lavorazioni.</span></h1>
    <p class="page-lead">Ogni idea ha la sua tecnica. Scopri cosa possiamo realizzare insieme e vai dritto alle informazioni che ti servono.</p>
  </section>
  <section class="section-wrap service-list">
    {services.map((service) => (
      <a class="service-row" href={`/servizi/${service.slug}/`}>
        <span class="row-index">{service.number}</span>
        <span class="row-title">{service.name}</span>
        <span class="row-description">{service.short}</span>
        <span class="row-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </section>
  <section class="simple-cta"><p>Hai una lavorazione in mente?</p><a class="button button-dark" href="/contatti/">Parliamone <span aria-hidden="true">↗</span></a></section>
</SiteLayout>
